{
  "agent_id": "com.cyberbyte.shipping_agent.v1",
  "name": "Shipping Agent",
  "description": "Calculates carrier rates, resolves shipping destinations, and issues dispatch tracking for CyberByte Hardwares orders.",
  "short_name": "ShippingAgent",
  "agent_type": "Logistics & Fulfillment",
  "version": "1.0.0",
  "status": "production",
  "ownership": {
    "org": "CyberByte Hardwares",
    "sub_org": "Logistics & Fulfillment",
    "creator": "Logistics Engineering Team",
    "license": "Internal",
    "repository": "https://github.com/cyberbyte-hardwares/shipping-agent"
  },
  "specialization": {
    "primary": "shipping_logistics",
    "domain_specific": [
      "rate_calculation",
      "address_validation",
      "shipping_label_generation",
      "carrier_tracking"
    ]
  },
  "capabilities": {
    "languages": ["Python", "JSON"],
    "frameworks": ["OpenAI Agents SDK", "FastAPI", "A2A"],
    "platforms": ["Linux", "Azure OpenAI"]
  },
  "tasks": {
    "task": [
      {
        "name": "get_shipping_rates",
        "description": "Calculates shipping rates for hardware order items to a valid destination address",
        "is_async": true,
        "estimated_duration_sec": 3,
        "requires_human_approval": false,
        "idempotent": true
      },
      {
        "name": "generate_shipping_label",
        "description": "Generates carrier tracking number and shipping label payload for verified destination addresses",
        "is_async": true,
        "estimated_duration_sec": 4,
        "requires_human_approval": false,
        "idempotent": false
      }
    ]
  },
  "runtime": {
    "language": "Python",
    "language_version": "3.11",
    "frameworks": ["OpenAI Agents SDK", "FastAPI", "A2A"],
    "os_type": "Linux",
    "architecture": "amd64"
  },
  "backend": {
    "redis_required": false,
    "postgre_required": true,
    "vector_store": "none",
    "vector_dimensions": 0,
    "redis_modules": []
  },
  "config": {
    "env_vars": [
      "AZURE_OPENAI_API_BASE",
      "AZURE_OPENAI_API_KEY",
      "AZURE_OPENAI_API_VERSION",
      "DEPLOYMENT_NAME",
      "CARRIER_API_KEY",
      "LOG_LEVEL",
      "AGENT_PORT",
      "AGENT_HOST",
      "ORCHESTRATOR_URL",
      "ORCHESTRATOR_TOKEN"
    ],
    "external_config": ["./shipping_agent_card.json"],
    "secrets": ["AZURE_OPENAI_API_KEY", "ORCHESTRATOR_TOKEN", "CARRIER_API_KEY"]
  },
  "maintainers": {
    "maintainers": [
      {
        "name": "Logistics Team Lead",
        "contact": "shipping.team@cyberbyte.com",
        "role": "lead",
        "availability": "UTC"
      }
    ]
  }
}