{
  "agent_id": "org.ecommerce.notification_agent.v1",
  "name": "Notification Agent",
  "description": "Assembles transactional message templates and dispatches alerts across channels (Email, SMS, Push). Handles order receipts, failure/decline alerts, and shipment tracking updates.",
  "short_name": "NotificationAgent",
  "agent_type": "Notification Management",
  "version": "1.0.0",
  "status": "production",
  "ownership": {
    "org": "Ecommerce Platform",
    "sub_org": "Customer Communications",
    "creator": "Notifications Team",
    "license": "Internal",
    "repository": "https://github.com/ecommerce/notification-agent"
  },
  "specialization": {
    "primary": "notification_management",
    "domain_specific": [
      "template_compilation",
      "email_dispatch",
      "sms_dispatch",
      "tracking_update_dispatch",
      "delivery_status_reporting"
    ]
  },
  "capabilities": {
    "languages": [
      "Python",
      "JSON"
    ],
    "frameworks": [
      "OpenAI Agents SDK",
      "FastAPI",
      "A2A"
    ],
    "platforms": [
      "Linux",
      "Azure OpenAI"
    ]
  },
  "tasks": {
    "task": [
      {
        "name": "send_receipt_email",
        "description": "Compile and send an order/payment receipt email to the customer",
        "is_async": true,
        "estimated_duration_sec": 3,
        "requires_human_approval": false,
        "idempotent": false
      },
      {
        "name": "send_failure_sms",
        "description": "Compile and send a short failure/alert SMS (e.g. payment declined, item unavailable)",
        "is_async": true,
        "estimated_duration_sec": 2,
        "requires_human_approval": false,
        "idempotent": false
      },
      {
        "name": "send_tracking_update",
        "description": "Compile and send a shipment tracking update (email or SMS) with carrier and tracking info",
        "is_async": true,
        "estimated_duration_sec": 2,
        "requires_human_approval": false,
        "idempotent": false
      }
    ]
  },
  "runtime": {
    "language": "Python",
    "language_version": "3.11",
    "frameworks": [
      "OpenAI Agents SDK",
      "FastAPI",
      "A2A"
    ],
    "os_type": "Linux",
    "architecture": "amd64"
  },
  "backend": {
    "redis_required": false,
    "postgre_required": false,
    "vector_store": "none",
    "vector_dimensions": 0,
    "redis_modules": []
  },
  "config": {
    "env_vars": [
      "AZURE_OPENAI_API_BASE",
      "AZURE_OPENAI_API_KEY",
      "AZURE_OPENAI_API_VERSION",
      "DEPLOYMENT_NAME",
      "AGENT_SESSION_DB",
      "LOG_LEVEL",
      "AGENT_PORT",
      "AGENT_HOST",
      "ORCHESTRATOR_URL",
      "ORCHESTRATOR_TOKEN"
    ],
    "external_config": [
      "./agent_card.json"
    ],
    "secrets": [
      "AZURE_OPENAI_API_KEY",
      "ORCHESTRATOR_TOKEN"
    ]
  },
  "maintainers": {
    "maintainers": [
      {
        "name": "Notifications Team Lead",
        "contact": "notifications.team@ecommerce.com",
        "role": "lead",
        "availability": "UTC"
      }
    ]
  }
}