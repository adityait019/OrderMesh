{
  "agent_id": "com.cyberbyte.notification_agent.v1",
  "name": "Notification Agent",
  "description": "Dispatches transactional emails, SMS alerts, and delivery updates for CyberByte Hardwares orders.",
  "short_name": "NotificationAgent",
  "agent_type": "Customer Communications",
  "version": "1.0.0",
  "status": "production",
  "ownership": {
    "org": "CyberByte Hardwares",
    "sub_org": "Customer Experience",
    "creator": "Communications Team",
    "license": "Internal",
    "repository": "https://github.com/cyberbyte-hardwares/notification-agent"
  },
  "specialization": {
    "primary": "notification_dispatch",
    "domain_specific": [
      "order_receipts",
      "shipping_notifications",
      "sms_alerts",
      "email_templates"
    ]
  },
  "capabilities": {
    "languages": ["Python", "JSON"],
    "frameworks": ["OpenAI Agents SDK", "FastAPI", "A2A"],
    "platforms": ["Linux", "Azure OpenAI"]
  },
  "tasks": {
    "task": [
      {
        "name": "dispatch_message",
        "description": "Dispatches order receipts, tracking info, and status notifications via email, SMS, or push channels",
        "is_async": true,
        "estimated_duration_sec": 2,
        "requires_human_approval": false,
        "idempotent": true
      }
    ]
  },
  "runtime": {
    "language": "Python",
    "language_version": "3.11",
    "frameworks": ["OpenAI Agents SDK", "FastAPI", "A2A"],
    "os_type": "Linux",
    "architecture": "amd64"
  },
  "backend": {
    "redis_required": false,
    "postgre_required": false,
    "vector_store": "none",
    "vector_dimensions": 0,
    "redis_modules": []
  },
  "config": {
    "env_vars": [
      "AZURE_OPENAI_API_BASE",
      "AZURE_OPENAI_API_KEY",
      "AZURE_OPENAI_API_VERSION",
      "DEPLOYMENT_NAME",
      "NOTIFICATION_PROVIDER_KEY",
      "LOG_LEVEL",
      "AGENT_PORT",
      "AGENT_HOST",
      "ORCHESTRATOR_URL",
      "ORCHESTRATOR_TOKEN"
    ],
    "external_config": ["./notification_agent_card.json"],
    "secrets": ["AZURE_OPENAI_API_KEY", "ORCHESTRATOR_TOKEN", "NOTIFICATION_PROVIDER_KEY"]
  },
  "maintainers": {
    "maintainers": [
      {
        "name": "Customer Communications Lead",
        "contact": "notification.team@cyberbyte.com",
        "role": "lead",
        "availability": "UTC"
      }
    ]
  }
}