{
  "agent_id": "com.cyberbyte.payment_agent.v1",
  "name": "Payment Agent",
  "description": "Handles payment authorizations, tokenized transactions, and payment failure handling for CyberByte Hardwares.",
  "short_name": "PaymentAgent",
  "agent_type": "Payment Processing",
  "version": "1.0.0",
  "status": "production",
  "ownership": {
    "org": "CyberByte Hardwares",
    "sub_org": "Finance Operations",
    "creator": "Payments Engineering Team",
    "license": "Internal",
    "repository": "https://github.com/cyberbyte-hardwares/payment-agent"
  },
  "specialization": {
    "primary": "payment_processing",
    "domain_specific": [
      "payment_authorization",
      "token_validation",
      "charge_capture",
      "refund_processing"
    ]
  },
  "capabilities": {
    "languages": ["Python", "JSON"],
    "frameworks": ["OpenAI Agents SDK", "FastAPI", "A2A"],
    "platforms": ["Linux", "Azure OpenAI"]
  },
  "tasks": {
    "task": [
      {
        "name": "process_payment_charge",
        "description": "Executes tokenized payment authorization and charge capture using secure payment references",
        "is_async": true,
        "estimated_duration_sec": 4,
        "requires_human_approval": false,
        "idempotent": false
      }
    ]
  },
  "runtime": {
    "language": "Python",
    "language_version": "3.11",
    "frameworks": ["OpenAI Agents SDK", "FastAPI", "A2A"],
    "os_type": "Linux",
    "architecture": "amd64"
  },
  "backend": {
    "redis_required": false,
    "postgre_required": true,
    "vector_store": "none",
    "vector_dimensions": 0,
    "redis_modules": []
  },
  "config": {
    "env_vars": [
      "AZURE_OPENAI_API_BASE",
      "AZURE_OPENAI_API_KEY",
      "AZURE_OPENAI_API_VERSION",
      "DEPLOYMENT_NAME",
      "PAYMENT_GATEWAY_URL",
      "PAYMENT_GATEWAY_KEY",
      "LOG_LEVEL",
      "AGENT_PORT",
      "AGENT_HOST",
      "ORCHESTRATOR_URL",
      "ORCHESTRATOR_TOKEN"
    ],
    "external_config": ["./payment_agent_card.json"],
    "secrets": ["AZURE_OPENAI_API_KEY", "ORCHESTRATOR_TOKEN", "PAYMENT_GATEWAY_KEY"]
  },
  "maintainers": {
    "maintainers": [
      {
        "name": "Payments Tech Lead",
        "contact": "payments.team@cyberbyte.com",
        "role": "lead",
        "availability": "UTC"
      }
    ]
  }
}