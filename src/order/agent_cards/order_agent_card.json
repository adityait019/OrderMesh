{
  "agent_id": "com.cyberbyte.order_agent.v1",
  "name": "Order Agent",
  "description": "Handles hardware order creation, line-item calculations, tax computation, and order lifecycle state management for CyberByte Hardwares.",
  "short_name": "OrderAgent",
  "agent_type": "Order Management",
  "version": "1.0.0",
  "status": "production",
  "ownership": {
    "org": "CyberByte Hardwares",
    "sub_org": "Order Processing",
    "creator": "Order Engineering Team",
    "license": "Internal",
    "repository": "https://github.com/cyberbyte-hardwares/order-agent"
  },
  "specialization": {
    "primary": "order_management",
    "domain_specific": [
      "order_creation",
      "financial_calculations",
      "tax_computation",
      "order_state_tracking",
      "discount_handling"
    ]
  },
  "capabilities": {
    "languages": ["Python", "JSON"],
    "frameworks": ["OpenAI Agents SDK", "FastAPI", "A2A"],
    "platforms": ["Linux", "Azure OpenAI"]
  },
  "tasks": {
    "task": [
      {
        "name": "create_order_record",
        "description": "Create a new order record with customer ID and hardware line items, initializing order state",
        "is_async": true,
        "estimated_duration_sec": 5,
        "requires_human_approval": false,
        "idempotent": false
      },
      {
        "name": "calculate_totals",
        "description": "Calculate line-item subtotals, apply hardware discounts, compute sales tax, and generate final total",
        "is_async": true,
        "estimated_duration_sec": 3,
        "requires_human_approval": false,
        "idempotent": true
      },
      {
        "name": "update_order_status",
        "description": "Update order lifecycle status (created, confirmed, payment_pending, payment_complete, preparing, shipped, delivered, cancelled)",
        "is_async": true,
        "estimated_duration_sec": 2,
        "requires_human_approval": false,
        "idempotent": false
      }
    ]
  },
  "runtime": {
    "language": "Python",
    "language_version": "3.11",
    "frameworks": ["OpenAI Agents SDK", "FastAPI", "A2A"],
    "os_type": "Linux",
    "architecture": "amd64"
  },
  "backend": {
    "redis_required": false,
    "postgre_required": true,
    "vector_store": "none",
    "vector_dimensions": 0,
    "redis_modules": []
  },
  "config": {
    "env_vars": [
      "AZURE_OPENAI_API_BASE",
      "AZURE_OPENAI_API_KEY",
      "AZURE_OPENAI_API_VERSION",
      "DEPLOYMENT_NAME",
      "ORDER_DB_URL",
      "LOG_LEVEL",
      "AGENT_PORT",
      "AGENT_HOST",
      "ORCHESTRATOR_URL",
      "ORCHESTRATOR_TOKEN"
    ],
    "external_config": ["./order_agent_card.json"],
    "secrets": ["AZURE_OPENAI_API_KEY", "ORCHESTRATOR_TOKEN", "ORDER_DB_URL"]
  },
  "maintainers": {
    "maintainers": [
      {
        "name": "Order Team Lead",
        "contact": "order.team@cyberbyte.com",
        "role": "lead",
        "availability": "UTC"
      }
    ]
  }
}